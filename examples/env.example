# Paths
CORECODER_ROOT=/root/CoreCoder_RL
SLIME_ROOT=/root/CoreCoder_RL/slime
HF_CKPT=/root/autodl-tmp/corecoder_rl/models/Qwen3-4B
REF_LOAD=/root/autodl-tmp/corecoder_rl/models/Qwen3-4B
SAVE_CKPT=/root/autodl-tmp/corecoder_rl/ckpt/corecoder-qwen3-4b-lora
PRM_MODEL_PATH=/root/autodl-tmp/corecoder_rl/models/Qwen3-4B

# Server
SGLANG_API_KEY=change-me
SERVED_MODEL_NAME=qwen3-4b
HOST=0.0.0.0
PORT=30000

# RL method
CORECODER_RL_METHOD=opsd
ADVANTAGE_ESTIMATOR=on_policy_distillation
CORECODER_TEACHER_LOGPROB_ENABLED=1
CORECODER_STUDENT_MODE=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# Metrics and automation
CORECODER_RECORD_ENABLED=1
CORECODER_METRICS_FILE=/root/CoreCoder_RL/results/corecoder_rl_metrics.jsonl
CORECODER_TRAIN_METRICS_FILE=/root/CoreCoder_RL/results/corecoder_train_metrics.jsonl
CORECODER_FEEDER_LIMIT=8
CORECODER_FEEDER_INTERVAL=20
USE_WANDB=0
